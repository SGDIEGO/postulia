# Copia este archivo a docker/.env y cambia todos los valores marcados.

# Dominio público del API (sin https://). Debe apuntar por DNS al servidor.
DOMAIN=postulia.example.com

# PostgreSQL
POSTGRES_DB=postulia
POSTGRES_USER=postulia
# Usa solo letras y números: se inserta en la URL de conexión.
POSTGRES_PASSWORD=cambia-esta-contrasena-larga

# Secreto de los JWT. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# Orígenes permitidos. Chrome asigna un id estable a la extensión al cargarla;
# puedes fijarlo (chrome-extension://<id>) o dejar el comodín mientras pruebas.
CORS_ORIGINS=chrome-extension://*

# Permite registrarse a cualquiera. Pon false cuando ya tengas tu cuenta.
ALLOW_REGISTRATION=true

# Base pública del API para los enlaces de los correos (sin barra final).
# Si lo dejas vacío se deduce del host de la petición.
PUBLIC_URL=https://postulia.example.com

# Verificación de correo al registrarse.
# El enlace caduca a los 30 minutos. Pon REQUIRE_EMAIL_VERIFICATION=false solo
# mientras la extensión publicada todavía no soporte este flujo.
EMAIL_VERIFICATION_TTL_MINUTES=30
REQUIRE_EMAIL_VERIFICATION=true

# SMTP global de la instalación. Es el remitente de TODOS los correos:
# verificación de cuenta y envío de postulaciones con el CV adjunto.
# Gmail: activa la verificación en dos pasos y genera una "contraseña de
# aplicación" (myaccount.google.com/apppasswords). No uses tu contraseña normal.
# Límite aproximado de Gmail: 500 correos al día.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Vacío = se usa SMTP_USER como remitente
SMTP_FROM=

# Registro y límite de peticiones
LOG_LEVEL=info
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
