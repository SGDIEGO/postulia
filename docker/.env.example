# Copia este archivo a docker/.env y cambia todos los valores marcados.

# Dominio público del API (sin https://). Debe apuntar por DNS al servidor.
DOMAIN=postulia.example.com

# PostgreSQL
POSTGRES_DB=postulia
POSTGRES_USER=postulia
# Usa solo letras y números: se inserta en la URL de conexión.
POSTGRES_PASSWORD=cambia-esta-contrasena-larga

# Secreto de los JWT. Genera uno con: openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# Orígenes permitidos. Chrome asigna un id estable a la extensión al cargarla;
# puedes fijarlo (chrome-extension://<id>) o dejar el comodín mientras pruebas.
CORS_ORIGINS=chrome-extension://*

# Permite registrarse a cualquiera. Pon false cuando ya tengas tu cuenta.
ALLOW_REGISTRATION=true

# Registro y límite de peticiones
LOG_LEVEL=info
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute
