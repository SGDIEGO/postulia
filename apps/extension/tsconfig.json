{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "allowImportingTsExtensions": false
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints/**/*.ts",
    "entrypoints/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "utils/**/*.ts",
    "wxt.config.ts"
  ]
}
