# Entorno de la API de Postulia
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgresql://postulia:postulia@localhost:5432/postulia?schema=public

# Secretos: genera uno con `openssl rand -base64 48`
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres

# Orígenes permitidos separados por coma. Incluye el id de tu extensión:
# chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_ORIGINS=chrome-extension://*

# Límite de peticiones
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW=1 minute

# Permite que cualquiera se registre (pon false si solo tú creas cuentas)
ALLOW_REGISTRATION=true

# IA (Gemini): cada usuario guarda su API key desde Ajustes.
# Este es solo el modelo por defecto cuando el usuario no elige uno.
GEMINI_MODEL=gemini-3.8-flash

# SMTP para enviar el correo con el CV adjunto
# Gmail: usa una contraseña de aplicación (myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Vacío = se usa SMTP_USER como remitente
SMTP_FROM=
