{
  "name": "@postulia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de Postulia: autenticación multiusuario, postulaciones y sincronización local-first",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@postulia/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "fastify": "^5.12.7",
    "fastify-plugin": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
